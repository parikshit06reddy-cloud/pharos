# Pharos environment. Copy to .env and edit. NEVER commit .env.
# ---------------------------------------------------------------------------
# Retrieval provider: "local" (default, fully offline) or "foundry_iq" (live).
RETRIEVAL_PROVIDER=local
# Expert-routing provider: "local" (default, offline) or "foundry" (LLM-assisted).
ROUTER_PROVIDER=local
# Navigation agent provider: "local" (default, offline) or "foundry" (LLM tool-calling).
AGENT_PROVIDER=local

# Grounding gate tuning (defaults shown). Do NOT loosen these to pass tests.
GROUNDING_THRESHOLD=0.6
GROUNDED_AT=0.45
INFERRED_AT=0.2

# Enterprise workflow (synthetic demo).
PHAROS_DB=data/pharos.db                 # SQLite file (or :memory:)
PHAROS_SECRET=pharos-dev-secret-change-me # signs demo auth tokens; set a real secret in any shared env
PHAROS_TOKEN_TTL=43200                    # token lifetime (seconds)

# ---------------------------------------------------------------------------
# Foundry IQ (only required when RETRIEVAL_PROVIDER=foundry_iq). Keyless auth
# via DefaultAzureCredential — no keys belong in this file.
FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<project>
SEARCH_SERVICE_ENDPOINT=https://<your-search>.search.windows.net
KNOWLEDGE_BASE_NAME=pharos-drug-labels
KNOWLEDGE_SOURCE_NAME=pharos-drug-labels-source
PROJECT_CONNECTION_NAME=<search-connection-name>
FOUNDRY_MODEL_DEPLOYMENT=<chat-model-deployment-name>
# GA, extractive retrieval (recommended). Preview (answer synthesis) is 2026-05-01-preview.
SEARCH_API_VERSION=2026-04-01
# Minimum Azure AI Search semantic reranker score to keep a reference (0 = keep all).
FOUNDRY_RERANKER_THRESHOLD=0
